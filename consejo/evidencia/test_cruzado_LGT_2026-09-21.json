   "frases_boe_ausentes_repo": [
    {
     "frase": "En el ámbito de las competencias del Estado, la facultad de dictar disposiciones interpretativas o aclaratorias de las leyes y demás normas en materia tributaria corresponde al Ministro de Hacienda y Administraciones Públicas y a los órganos de la Administración Tributaria a los que se refiere el artículo 88.5 de esta Ley."
    },
    {
     "frase": "Las disposiciones interpretativas o aclaratorias dictadas por el Ministro serán de obligado cumplimiento para todos los órganos de la Administración Tributaria."
    },
    {
     "frase": "Las disposiciones interpretativas o aclaratorias dictadas por los órganos de la Administración Tributaria a los que se refiere el artículo 88.5 de esta Ley tendrán efectos vinculantes para los órganos y entidades de la Administración Tributaria encargados de la aplicación de los tributos."
    },
    {
     "frase": "Las disposiciones interpretativas o aclaratorias previstas en este apartado se publicarán en el boletín oficial que corresponda."
    },
    {
     "frase": "Con carácter previo al dictado de las resoluciones a las que se refiere este apartado, y una vez elaborado su texto, cuando la naturaleza de las mismas lo aconseje, podrán ser sometidas a información pública."
    }
   ],
   "frases_repo_sin_traza_boe": [
    {
     "frase": "En el ámbito de las competencias del Estado, corresponde al Ministro de Hacienda la facultad exclusiva de dictar disposiciones interpretativas de las leyes y demás normas en materia tributaria.",
     "palabras_nuevas": [
      "exclusiva"
     ]
    },
    {
     "frase": "Las disposiciones interpretativas serán de obligado cumplimiento para todos los órganos de la Administración tributaria y se publicarán en el boletín oficial que corresponda.",
     "palabras_nuevas": []
    },
    {
     "frase": "Los órganos de la Administración Tributaria a los que se refiere el artículo 88.5 podrán dictar criterios de aplicación interna vinculantes para los órganos y entidades de su dependencia, que se publicarán en el boletín oficial correspondiente.",
     "palabras_nuevas": [
      "correspondiente",
      "criterios",
      "dependencia",
      "interna"
     ]
    },
    {
     "frase": "Con carácter previo a su dictado, y cuando la naturaleza de los mismos lo aconseje, podrán ser sometidos a información pública.",
     "palabras_nuevas": [
